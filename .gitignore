# ---------------------------------------------------------------------------
# Toolchains and vendored flows. Multi-gigabyte, installed per machine, and
# orfs/ is itself a git clone. LAPTOP_HANDOFF.md covers reinstalling these.
# ---------------------------------------------------------------------------
/orfs/
/oss-cad-suite/

# Third-party papers and course material: not ours to redistribute, and 30 MB
# of PDF nobody needs to clone. The reading list is in CLAUDE.md.
/references/
/book/

# Scratch media.
/misc/

# ---------------------------------------------------------------------------
# Run outputs. The rule is: keep the JSON a report or the demo reads, drop
# the working directories that produced it. demo.py --replay reads from
# artifacts/, so those summaries have to be tracked or a fresh clone cannot
# run the demo at all.
# ---------------------------------------------------------------------------
/artifacts/eqy/*/*/
/artifacts/synth/
/artifacts/loop/cand_*/
/artifacts/loop/rtl/
/artifacts/loop/rtl_accepted/
/artifacts/loop/rtl_frozen/
/artifacts/loop_g1b/
/artifacts/wns/dryrun/cand_*/
/artifacts/wns/dryrun/rtl/
/artifacts/pnr_opt.log
/artifacts/final_candidate/orfs_run/
/artifacts/eqy/soc_top_suffix_fix/
/artifacts/bakeoff_all/
/artifacts/bakeoff_audit_20260911/
/artifacts/bakeoff*/**/cand_*/
/artifacts/bakeoff*/**/rtl/
/tmp/

# ---------------------------------------------------------------------------
# Credentials. Keys live in ~/.config/nebula/env, outside this tree, and are
# read from the environment by bench/scripts/llm.py. Nothing key-shaped
# belongs in the repo; this is a backstop, not the mechanism.
# ---------------------------------------------------------------------------
.env
*.env
*.key
*.pem
secrets*

__pycache__/
*.pyc
.DS_Store

# ---------------------------------------------------------------------------
# Embedded clones. Git will not carry these for a cloner -- it records a bare
# gitlink and the directory comes out empty -- so tracking them is worse than
# not tracking them. Each is cloned separately; see LAPTOP_HANDOFF.md.
# ---------------------------------------------------------------------------
/Design-and-Implementation-of-a-Multi-Clock-Domain-RISC-V-SoC-Subsystems/
/orfs_custom/tools/eqy_src/

# Superseded synthesis netlists from the custom-flow experiments: 4 MB each,
# regenerated by a synth run, and none of them is the current design.
/orfs_custom/flow/artifacts/

# ---------------------------------------------------------------------------
# v2/v3 generation (2026-09-13..15). Same rule as above: keep the JSON/log a
# report or demo_v2.py reads, drop the working directories that produced it.
# EQY solver scratch under artifacts/eqy/shards/ alone is 9.3 GB; the ORFS run
# dirs under artifacts/model_ppa_*/ are another 24 GB.
# ---------------------------------------------------------------------------
/artifacts/eqy/shards/*/
/artifacts/eqy/v2_work_*/
/artifacts/model_ppa_*/*/
/artifacts/timing_close_*/*/
/artifacts/v2_synth/

# ---------------------------------------------------------------------------
# Evidence kept on purpose, against the rules above (2026-09-15). The
# submission is this repository, not a zip, so every file a report table or
# demo_v2.py cites has to survive a fresh clone: the per-candidate proposals
# under artifacts/bakeoff_v2*/ (the funnel in Table 4) and the v3 PnR reports
# under artifacts/model_ppa_v3/ (Table 10). They are tracked with `git add -f`
# and stay tracked -- do not re-ignore them. The multi-gigabyte ODB/SPEF run
# databases beside them are still excluded.
# ---------------------------------------------------------------------------
.claude/
