library (id_memory_256x64_TT_1p8V_25C_lib){
    delay_model : "table_lookup";
    time_unit : "1ns" ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    resistance_unit : "1kohm" ;
    capacitive_load_unit(1, pF) ;
    leakage_power_unit : "1mW" ;
    pulling_resistance_unit : "1kohm" ;
    operating_conditions(OC){
    process : 1.0 ;
    voltage : 1.8 ;
    temperature : 25;
    }

    input_threshold_pct_fall       :  50.0 ;
    output_threshold_pct_fall      :  50.0 ;
    input_threshold_pct_rise       :  50.0 ;
    output_threshold_pct_rise      :  50.0 ;
    slew_lower_threshold_pct_fall  :  10.0 ;
    slew_upper_threshold_pct_fall  :  90.0 ;
    slew_lower_threshold_pct_rise  :  10.0 ;
    slew_upper_threshold_pct_rise  :  90.0 ;

    nom_voltage : 1.8;
    nom_temperature : 25;
    nom_process : 1.0;
    default_cell_leakage_power    : 0.0 ;
    default_leakage_power_density : 0.0 ;
    default_input_pin_cap    : 1.0 ;
    default_inout_pin_cap    : 1.0 ;
    default_output_pin_cap   : 0.0 ;
    default_max_transition   : 0.5 ;
    /* PATCHED FOR NEBULA: OpenRAM wrote max_transition : 0.005 (5 ps) on the
       two address buses. That is the slew it characterised at, not a limit
       the macro can hold anyone to -- no sky130hd driver reaches better than
       ~20 ps even unloaded, so the resizer aborted with RSZ-0090 before it
       could place a single cell. Both are now 0.5 ns, the library's own
       default_max_transition. Timing arcs are untouched. Original kept as
       <name>.lib.openram_orig. */
    default_fanout_load      : 1.0 ;
    default_max_fanout   : 4.0 ;
    default_connection_class : universal ;

    voltage_map ( VCCD1, 1.8 );
    voltage_map ( VSSD1, 0 );

    lu_table_template(CELL_TABLE){
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.005");
        index_2("0.006889999999999999");
    }

    lu_table_template(CONSTRAINT_TABLE){
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.005");
        index_2("0.005");
    }

    default_operating_conditions : OC; 


    type (data){
    base_type : array;
    data_type : bit;
    bit_width : 256;
    bit_from : 255;
    bit_to : 0;
    }

    type (addr){
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
    }

cell (id_memory_256x64){
    memory(){ 
    type : ram;
    address_width : 7;
    word_width : 256;
    }
    interface_timing : true;
    dont_use  : true;
    map_only   : true;
    dont_touch : true;
    area : 504669.27060000005;

    pg_pin(vccd1) {
         voltage_name : VCCD1;
         pg_type : primary_power;
    }

    pg_pin(vssd1) {
         voltage_name : VSSD1;
         pg_type : primary_ground;
    }

    leakage_power () {
      value : 0.01822;
    }
    cell_leakage_power : 0.01822;
    bus(din0){
        bus_type  : data; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        memory_write(){ 
            address : addr0; 
            clocked_on  : clk0; 
        }
        pin(din0[255:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
        }
    }
    bus(dout0){
        bus_type  : data; 
        direction  : output; 
        max_capacitance : 0.006889999999999999;  
        min_capacitance : 0.006889999999999999;  
        memory_read(){ 
            address : addr0; 
        }
        pin(dout0[255:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk0"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("0.63");
            }
            cell_fall(CELL_TABLE) {
            values("0.63");
            }
            rise_transition(CELL_TABLE) {
            values("0.005");
            }
            fall_transition(CELL_TABLE) {
            values("0.005");
            }
        }
        }
    }

    bus(addr0){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.5;
        pin(addr0[6:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
        }
    }

    pin(csb0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
    }

    pin(web0){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb0 & !web0"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        internal_power(){
            when : "csb0 & !web0"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        internal_power(){
            when : "!csb0 & web0"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        internal_power(){
            when : "csb0 & web0"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("1.1655"); 
            }
            fall_constraint(scalar) {
                values("1.1655"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("2.331"); 
            }
            fall_constraint(scalar) {
                values("2.331"); 
            }
         }
    }

    bus(dout1){
        bus_type  : data; 
        direction  : output; 
        max_capacitance : 0.006889999999999999;  
        min_capacitance : 0.006889999999999999;  
        memory_read(){ 
            address : addr1; 
        }
        pin(dout1[255:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk1"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("0.63");
            }
            cell_fall(CELL_TABLE) {
            values("0.63");
            }
            rise_transition(CELL_TABLE) {
            values("0.005");
            }
            fall_transition(CELL_TABLE) {
            values("0.005");
            }
        }
        }
    }

    bus(addr1){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.006889999999999999;  
        max_transition       : 0.5;
        pin(addr1[6:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
        }
    }

    pin(csb1){
        direction  : input; 
        capacitance : 0.006889999999999999;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.103");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.056");
            }
        }
    }

    pin(clk1){
        clock             : true;
        direction  : input; 
        capacitance : 0.006889999999999999;  
        internal_power(){
            when : "!csb1"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        internal_power(){
            when : "csb1"; 
            rise_power(scalar){
                values("1.173979e+11");
            }
            fall_power(scalar){
                values("1.173979e+11");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk1; 
            rise_constraint(scalar) {
                values("1.1655"); 
            }
            fall_constraint(scalar) {
                values("1.1655"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk1; 
            rise_constraint(scalar) {
                values("2.331"); 
            }
            fall_constraint(scalar) {
                values("2.331"); 
            }
         }
    }

    }
}
