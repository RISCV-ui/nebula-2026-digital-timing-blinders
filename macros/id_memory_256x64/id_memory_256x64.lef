VERSION 5.4 ;
NAMESCASESENSITIVE ON ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
# PATCHED FOR NEBULA: OpenRAM emits 2000 dbu/um, but the sky130hd tech LEF
# declares 1000 and OpenROAD refuses a macro LEF with a finer factor than the
# technology (ODB-0292). Every coordinate in this file has at most three
# decimals, so 1000 dbu/um represents all of them exactly -- nothing is
# snapped or lost. Original kept alongside as <name>.lef.openram_orig.
UNITS
  DATABASE MICRONS 1000 ;
END UNITS
